APP_ENV=development
APP_PORT=8080
JWT_SECRET=replace-with-a-long-secret
JWT_ISSUER=tenant-access-service
JWT_AUDIENCE=tenant-access-service
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tenant_access_service
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_ACQUIRE_TIMEOUT=5s
DB_MAX_CONN_LIFETIME=30m
DB_MAX_IDLE_TIME=10m
PERMISSION_CACHE_TTL=5m
